# Copy to .env next to docker-compose.prod.yml on the VPS. Never commit the real file.
# Public hostname; its DNS A record must point at this VPS before requesting the TLS certificate.
AGENT_OFFICE_DOMAIN=my-studio.example.com
# Loopback port the host reverse proxy (nginx) forwards to.
AGENT_OFFICE_BIND_PORT=8090
# Let agents' permission prompts be answered from the web UI.
AGENT_OFFICE_REMOTE_APPROVAL=true
# The manager password is NOT stored here: deploy/setup-manager.sh prompts for it once (16+ characters).
# Optional Telegram notifications (permission prompts with Allow/Deny buttons, runner failures).
# Bot token from @BotFather; pair your chat afterwards in the web UI (Setup → Thông báo Telegram).
AGENT_OFFICE_TELEGRAM_BOT_TOKEN=
# Proxy for all Telegram traffic: http://user:pass@host:port or socks5://user:pass@host:port (empty = direct).
AGENT_OFFICE_TELEGRAM_PROXY=
