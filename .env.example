# Local application data directory. Defaults to ./data.
AGENT_OFFICE_DATA_DIR=./data

# HTTP bind address. Keep 127.0.0.1 for local-only mode.
AGENT_OFFICE_HOST=127.0.0.1
AGENT_OFFICE_PORT=8080

# Only true inside explicitly configured Docker mode; never use for local process.
AGENT_OFFICE_CONTAINER_MODE=false

# Session lifetime in seconds.
AGENT_OFFICE_SESSION_TTL_SECONDS=43200

# Auto-wake budget: consecutive Stop-hook wakes per seat before it must be re-armed by a human prompt or manager message.
AGENT_OFFICE_MAX_AUTO_WAKES=15
# Seat pinged in #leaders when a department with tasks in progress posts nothing for N minutes (0 = off).
AGENT_OFFICE_STATUS_CHECK_SEAT=pm
AGENT_OFFICE_STATUS_CHECK_MINUTES=45

# Stop-hook long-poll window in seconds (keep below the Stop hook "timeout" of 600 in Claude settings).
AGENT_OFFICE_WAKE_WAIT_SECONDS=290

# Connector/session credential directory used by the Claude hook and MCP server. Defaults to ~/.agent-office.
# AGENT_OFFICE_HOME=~/.agent-office

# Daemon URL used by npm run connect and the Vite dev proxy.
# AGENT_OFFICE_DAEMON_URL=http://127.0.0.1:8080

# --- Public deployment (see docker-compose.prod.yml) ---
# Public https origin behind the reverse proxy; adds it to the Host/Origin allowlists and marks the cookie Secure.
# AGENT_OFFICE_PUBLIC_ORIGIN=https://my-studio.example.com
# Trust the proxy's X-Forwarded-For for login throttling. Only when the daemon port is reachable solely via the proxy.
# AGENT_OFFICE_TRUST_PROXY=false
# Minimum manager password length (floor 8). Use 16+ when public.
# AGENT_OFFICE_MIN_PASSWORD_LENGTH=8
# Let agents' PermissionRequest hooks hand prompts to the manager UI (Allow/Deny). Off by default.
# AGENT_OFFICE_REMOTE_APPROVAL=false

# --- Agent machines (read by the Claude hook, not the daemon) ---
# Seconds a permission prompt waits for Allow/Deny in the web UI before the terminal prompt appears. 0 = off.
# AGENT_OFFICE_PERMISSION_WAIT_SECONDS=120
